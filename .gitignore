# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Environment / secrets
.env
.env.local
.env*.local

# Private data
/data/database/*
!/data/database/.gitkeep
/data/recordings/*
!/data/recordings/.gitkeep
/data/backups/*
!/data/backups/.gitkeep
/data/exports/*
!/data/exports/.gitkeep
/data/logs/*
!/data/logs/.gitkeep
/certs/
/mkcert.exe
/coverage/