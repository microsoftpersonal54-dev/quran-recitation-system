generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ USERS & AUTH ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  recordings        Recording[]         @relation("student_recordings")
  qariSessions      Recording[]         @relation("qari_sessions")
  mistakes          Mistake[]           @relation("reviewer_mistakes")
  notifications     Notification[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  attendance        Attendance[]        @relation("student_attendance")
  markedLeaves      Attendance[]        @relation("marked_attendance")

  @@index([role])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Recording {
  id            String    @id @default(cuid())
  studentId     String
  qariId        String?
  surahNumber   Int
  surahName     String
  ayahFrom      Int
  ayahTo        Int
  paraNumber    Int?
  paraFrom      Int?
  paraTo        Int?
  paraQuarter   Int?
  durationMs    Int
  notes         String?
  filePath      String
  fileName      String
  mimeType      String
  fileSizeBytes Int
  checksum      String?
  uploadStatus  String    @default("PENDING")
  reviewStatus  String    @default("UNREVIEWED")
  recordedAt    DateTime  @default(now())
  uploadedAt    DateTime?
  timezone      String    @default("UTC")
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  analysisStatus   String?
  transcription    String?
  detectedAyahs    String?
  confidence       Float?
  detectedIssues   String?
  analysisProvider String?
  analysisVersion  String?

  student       User           @relation("student_recordings", fields: [studentId], references: [id])
  qari          User?          @relation("qari_sessions", fields: [qariId], references: [id])
  mistakes      Mistake[]
  notifications Notification[]

  @@index([studentId])
  @@index([qariId])
  @@index([recordedAt])
  @@index([surahNumber])
  @@index([reviewStatus])
}

model Mistake {
  id          String   @id @default(cuid())
  recordingId String
  reviewerId  String
  timestampMs Int
  ayahNumber  Int?
  category    String
  severity    String
  description String
  correction  String?
  source      String   @default("REVIEWER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  reviewer  User      @relation("reviewer_mistakes", fields: [reviewerId], references: [id])

  @@index([recordingId])
  @@index([category])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recordingId String?
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  date       DateTime
  status     String
  reason     String?
  notes      String?
  markedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  User  @relation("student_attendance", fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User? @relation("marked_attendance", fields: [markedById], references: [id])

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId])
}